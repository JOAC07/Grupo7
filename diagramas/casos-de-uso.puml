@startuml CU_SAS
title Diagrama de Casos de Uso - Sistema SAS
left to right direction
skinparam packageStyle rectangle

actor "Usuario Autorizado" as Usuario
actor "Dueño del Comercio" as Dueno
actor "Encargado del Comercio" as Encargado
actor "Administrador del Sistema" as Admin
actor "Loyverse" as LOY <<sistema externo>>
actor "Telegram" as TG <<sistema externo>>

Dueno --|> Usuario
Encargado --|> Usuario

rectangle "Sistema SAS" {
  usecase "CU-01\nConsultar Stock de Producto" as CU01
  usecase "CU-02\nConsultar Ventas por Período" as CU02
  usecase "CU-03\nConsultar Productos Más Vendidos" as CU03
  usecase "CU-04\nConsultar Resumen del Negocio" as CU04
  usecase "CU-05\nGenerar Reporte" as CU05
  usecase "CU-06\nRecibir Alerta de Stock Bajo" as CU06
  usecase "CU-07\nNotificar Comando Inválido" as CU07
  usecase "CU-08\nMonitorear Flujos del Sistema" as CU08
  usecase "CU-09\nMantener Infraestructura del Sistema" as CU09
}

Usuario -- CU01
Usuario -- CU02
Usuario -- CU03
Usuario -- CU04
Usuario -- CU05
Usuario -- CU06
Usuario -- CU07

Admin -- CU08
Admin -- CU09

CU01 -- LOY
CU02 -- LOY
CU03 -- LOY
CU04 -- LOY
CU05 -- LOY
CU06 -- LOY
CU09 -- LOY

CU06 -- TG
CU09 -- TG

@enduml
