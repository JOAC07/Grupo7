@startuml
title Modelo Entidad-Relación - Sistema SAS

' --- Entidades ---
entity Producto {
  * id_producto : integer <<PK>>
  --
  nombre : varchar
  codigo : varchar
  categoria : varchar
  stock_actual : integer
  stock_minimo : integer
}

entity Venta {
  * id_venta : integer <<PK>>
  --
  id_producto : integer <<FK>>
  cantidad : integer
  monto : decimal
  fecha : datetime
}

entity Alerta {
  * id_alerta : integer <<PK>>
  --
  id_producto : integer <<FK>>
  fecha_hora : datetime
  stock_al_momento : integer
}

entity Usuario {
  * id_usuario : integer <<PK>>
  --
  telegram_id : varchar
  nombre : varchar
}

' --- Relaciones ---
Producto ||--o{ Venta : "se vende en"
Producto ||--o{ Alerta : "genera"

@enduml
